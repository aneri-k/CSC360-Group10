
<?xml version="1.0" encoding="UTF-8"?>

<!--
    Maven Project Configuration (pom.xml)
    Defines project details, Java version, dependencies, build plugins,
    testing configuration, and packaging settings.
-->

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- Specifies the Maven Project Object Model version -->
    <modelVersion>4.0.0</modelVersion>

    <!-- Basic project identification details -->
    <groupId>birdcount</groupId>
    <artifactId>bird-counting</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <!-- Project name and description -->
    <name>Counting Birds in the Garden</name>
    <description>
        Undergraduate CGIP project: detect and count bird-shaped objects in a garden
        PNG image using ImageJ thresholding and connected-component analysis.
    </description>

    <!-- Project-wide properties and Java compiler settings -->
    <properties>

        <!-- Java version used by the project -->
        <java.version>21</java.version>

        <!-- Java source and target compatibility -->
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>

        <!-- Character encoding used for project files -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Entry-point class containing the main() method -->
        <mainClass>Main</mainClass>

    </properties>

    <!-- External libraries required by the project -->
    <dependencies>

        <!-- ImageJ 1.x – provides image processing, thresholding,
             particle analysis, and image input/output functionality -->
        <dependency>
            <groupId>net.imagej</groupId>
            <artifactId>ij</artifactId>
            <version>1.54f</version>
        </dependency>

        <!-- JUnit 5 – provides tools for writing and executing unit tests.
             Test scope means it is not required for the application at runtime. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- Build configuration: defines how Maven compiles, tests,
         and packages the application -->
    <build>
        <plugins>

            <!-- Maven Compiler Plugin:
                 Compiles the Java source files using Java 21 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.12.1</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>

            <!-- Maven Surefire Plugin:
                 Executes the project's JUnit 5 test cases -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>

                    <!-- Disables the Java module path for test execution -->
                    <useModulePath>false</useModulePath>

                </configuration>
            </plugin>

            <!-- Maven Shade Plugin:
                 Creates an executable JAR containing the application
                 and its required external dependencies -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>

                        <!-- Runs the shading process during the package phase -->
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>

                        <configuration>

                            <!-- Keeps the original dependency information
                                 in the generated POM -->
                            <createDependencyReducedPom>false</createDependencyReducedPom>

                            <!-- Configures the executable JAR manifest -->
                            <transformers>
                                <transformer implementation=
                                    "org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">

                                    <!-- Specifies the application's entry-point class -->
                                    <mainClass>${mainClass}</mainClass>

                                </transformer>
                            </transformers>

                            <!-- Excludes signature files that may cause conflicts
                                 when dependencies are combined into one JAR -->
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>

                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

    <!-- Additional Maven repository used to download ImageJ dependencies -->
    <repositories>
        <repository>
            <id>imagej.public</id>
            <url>https://maven.imagej.net/content/groups/public</url>
        </repository>
    </repositories>

</project>
